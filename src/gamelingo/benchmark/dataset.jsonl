{"id": "dlg_01", "category": "Dialogue", "context": "Greeting", "source_text": "こんにちは！", "reference": "Hello!"}
{"id": "dlg_02", "category": "Dialogue", "context": "Greeting", "source_text": "おはようございます。", "reference": "Good morning."}
{"id": "dlg_03", "category": "Dialogue", "context": "Farewell", "source_text": "さようなら。", "reference": "Goodbye."}
{"id": "dlg_04", "category": "Dialogue", "context": "Thanks", "source_text": "ありがとうございます！", "reference": "Thank you very much!"}
{"id": "dlg_05", "category": "Dialogue", "context": "Apology", "source_text": "ごめんなさい...", "reference": "I'm sorry..."}
{"id": "dlg_06", "category": "Dialogue", "context": "Casual", "source_text": "やったぜ！", "reference": "We did it!"}
{"id": "dlg_07", "category": "Dialogue", "context": "Angry", "source_text": "ふざけるな！", "reference": "Don't mess with me!"}
{"id": "dlg_08", "category": "Dialogue", "context": "Surprised", "source_text": "えっ！？本当ですか？", "reference": "Huh!? Is that true?"}
{"id": "dlg_09", "category": "Dialogue", "context": "Sad", "source_text": "悲しいよ...", "reference": "I'm sad..."}
{"id": "dlg_10", "category": "Dialogue", "context": "Determined", "source_text": "絶対に諦めない！", "reference": "I will never give up!"}
{"id": "msg_01", "category": "System Message", "context": "Battle", "source_text": "%1の攻撃！", "reference": "%1 attacks!"}
{"id": "msg_02", "category": "System Message", "context": "Battle", "source_text": "%1は%2のダメージを受けた！", "reference": "%1 took %2 damage!"}
{"id": "msg_03", "category": "System Message", "context": "Battle", "source_text": "しかし、効果がなかった！", "reference": "But it had no effect!"}
{"id": "msg_04", "category": "System Message", "context": "Level up", "source_text": "%1はレベル%2に上がった！", "reference": "%1 leveled up to %2!"}
{"id": "msg_05", "category": "System Message", "context": "Item pickup", "source_text": "「%1」を手に入れた！", "reference": "Obtained '%1'!"}
{"id": "msg_06", "category": "System Message", "context": "Gold pickup", "source_text": "%1 Gを手に入れた！", "reference": "Obtained %1 G!"}
{"id": "msg_07", "category": "System Message", "context": "Quest complete", "source_text": "クエスト「%1」を達成した！", "reference": "Quest '%1' completed!"}
{"id": "msg_08", "category": "System Message", "context": "Save successful", "source_text": "セーブしました。", "reference": "Saved successfully."}
{"id": "msg_09", "category": "System Message", "context": "Load failed", "source_text": "ロードに失敗しました。", "reference": "Failed to load."}
